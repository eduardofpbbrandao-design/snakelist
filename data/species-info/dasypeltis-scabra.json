    "overview": [
      {
        "text": "The Common (Rhombic) Egg Eater is a harmless African snake that eats nothing but eggs. It has almost no teeth.",
        "src": [
          "wp"
        ]
      }
    ],
    "identification": [
      {
        "text": "Diamond-shaped dark brown spots down a lighter back, brown spots on the sides and a V-shaped mark on the neck.",
        "src": [
          "wp"
        ]
      }
    ],
    "distribution": [
      {
        "label": "Native",
        "text": "Africa south of the Sahara.",
        "src": [
          "wp",
          "rdb"
        ]
      }
    ],
    "habitat": [
      {
        "text": "Most habitats from sea level to 2,600 m, except closed forest and true desert.",
        "src": [
          "wp"
        ]
      }
    ],
    "behaviour": [
      {
        "text": "Active at night. Mostly on the ground, but it climbs rocks and trees to raid birds' nests.",
        "src": [
          "wp"
        ]
      }
    ],
    "diet": [
      {
        "text": "Only eggs. Ridges inside its mouth, like fingerprints, help it grip the shell.",

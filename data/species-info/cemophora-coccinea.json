    "overview": [
      {
        "text": "The Scarlet Snake is a small, harmless burrowing snake of the south-eastern United States, banded red, black and white or yellow.",
        "src": [
          "wp"
        ]
      }
    ],
    "identification": [
      {
        "text": "Light grey with black-bordered red blotches separated by white or yellow.",
        "src": [
          "wp"
        ]
      }
    ],
    "size": [
      {
        "label": "Adults",
        "text": "About 36 to 66 cm long.",
        "src": [
          "wp"
        ]
      }
    ],
    "distribution": [
      {
        "label": "Native",
        "text": "The south-eastern USA, from Florida north to New Jersey and west to eastern Texas and Oklahoma.",
        "src": [
          "wp",
          "rdb"
        ]
      }
    ],
    "behaviour": [
      {
        "text": "Active at night and only in summer; by day it hides under logs and pine litter or underground. It is often seen crossing roads at night.",
        "src": [
          "wp"
        ]
      }
    ],
    "reproduction": [
      {
        "text": "Lays 2 to 9 eggs.",
        "src": [
          "wp"
        ]
      }
    ]
  },
  "recognise": [
    {

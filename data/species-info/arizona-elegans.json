    "overview": [
      {
        "text": "The Glossy (or Faded) Snake is a harmless, night-active snake of the south-western United States and northern Mexico. It looks like a pale, washed-out gopher snake.",
        "src": [
          "wp"
        ]
      }
    ],
    "identification": [
      {
        "text": "Like a small, pale gopher snake with a narrow, pointed head.",
        "src": [
          "wp"
        ]
      }
    ],
    "distribution": [
      {
        "label": "Native",
        "text": "South-western USA (from Arizona and Utah east to Kansas, Oklahoma and Texas) and northern Mexico.",
